<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_top_rounded"
        android:paddingHorizontal="5dp">

        <LinearLayout
            android:id="@+id/ll_home_page"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@mipmap/icon_nav_home"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="首页"
                android:textSize="18dp"
                android:gravity="center_horizontal"
                android:textColor="@color/navigation_bar"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_scenic_page"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@mipmap/icon_nav_scenic"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="景点"
                android:textSize="18dp"
                android:gravity="center_horizontal"
                android:textColor="@color/navigation_bar"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_route_page"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@mipmap/icon_nav_route"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="路线"
                android:textSize="18dp"
                android:gravity="center_horizontal"
                android:textColor="@color/navigation_bar"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_mine_page"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@mipmap/icon_nav_mine"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="个人中心"
                android:textSize="18dp"
                android:gravity="center_horizontal"
                android:textColor="@color/navigation_bar"/>
        </LinearLayout>


    </LinearLayout>
</layout>